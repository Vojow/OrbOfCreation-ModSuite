<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>OrbMentor</AssemblyName>
    <RootNamespace>OrbMentor</RootNamespace>
    <Version>0.3.0</Version>
    <RequireGameReferences>true</RequireGameReferences>
    <Description>Native spell, artifact, and alchemy mastery catch-up for Orb Of Creation.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OrbModding.Common\OrbModding.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OrbModding.Tests" />
  </ItemGroup>
  <ItemGroup Condition="'$(RequireGameReferences)' == 'true' and '$(UseGameStubs)' != 'true' and '$(GameRoot)' != ''">
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
