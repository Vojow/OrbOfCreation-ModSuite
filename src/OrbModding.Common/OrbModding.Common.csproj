<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>OrbModding.Common</AssemblyName>
    <RootNamespace>OrbModding.Common</RootNamespace>
    <RequireGameReferences>true</RequireGameReferences>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <Description>Gameplay-neutral runtime and safety contracts for Orb Of Creation BepInEx plugins.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OrbModding.Tests" />
    <InternalsVisibleTo Include="OrbAutomata" />
    <InternalsVisibleTo Include="OrbMentor" />
    <InternalsVisibleTo Include="OrbModding.ServiceCycleTrace" />
    <InternalsVisibleTo Include="OrbModding.ProfileTests" Condition="'$(EnableServiceCycleProfiler)' == 'true'" />
  </ItemGroup>

  <Target Name="VerifyKnownEntitiesGenerated" BeforeTargets="BeforeCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../tools/generate-known-entities.ps1&quot; -Verify" />
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="bash &quot;$(MSBuildProjectDirectory)/../../tools/generate-known-entities.sh&quot; -Verify" />
  </Target>

  <ItemGroup Condition="'$(RequireGameReferences)' == 'true' and '$(UseGameStubs)' != 'true' and '$(GameRoot)' != ''">
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
