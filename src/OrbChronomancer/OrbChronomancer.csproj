<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>OrbChronomancer</AssemblyName>
    <RootNamespace>OrbChronomancer</RootNamespace>
    <Version>0.1.0</Version>
    <RequireGameReferences>true</RequireGameReferences>
    <Description>Safe simulation-speed controls for Orb Of Creation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrbModding.Common\OrbModding.Common.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(RequireGameReferences)' == 'true' and '$(UseGameStubs)' != 'true' and '$(GameRoot)' != ''">
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OrbModding.Tests" />
  </ItemGroup>
</Project>
