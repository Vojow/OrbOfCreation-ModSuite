<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>OrbModding.Tests</AssemblyName>
    <RequireGameReferences>false</RequireGameReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OrbModding.GameStubs/OrbModding.GameStubs.csproj" />
    <ProjectReference Include="../OrbModding.RuntimeReplay/OrbModding.RuntimeReplay.csproj" />
    <ProjectReference Include="../../tools/OrbModding.ReplayConverter/OrbModding.ReplayConverter.csproj" />
    <ProjectReference Include="../../tools/OrbModding.PerformanceEvidence/OrbModding.PerformanceEvidence.csproj" />
    <ProjectReference Include="../../src/OrbAutomata/OrbAutomata.csproj" />
    <ProjectReference Include="../../src/OrbModConfig/OrbModConfig.csproj" />
    <ProjectReference Include="../../src/OrbMentor/OrbMentor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../data/entity-mappings.tsv" Link="data/entity-mappings.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/entity-types.tsv" Link="data/entity-types.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/known-entities.tsv" Link="data/known-entities.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/suite-performance-profile-v1.json" Link="data/suite-performance-profile-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tools/generate-known-entities.ps1" Link="tools/generate-known-entities.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/automata/*.log" Link="fixtures/automata/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/replays/*.json" Link="fixtures/replays/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
