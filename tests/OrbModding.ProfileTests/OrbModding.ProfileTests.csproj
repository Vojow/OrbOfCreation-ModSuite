<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>OrbModding.ProfileTests</AssemblyName>
    <RequireGameReferences>false</RequireGameReferences>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OrbModding.GameStubs/OrbModding.GameStubs.csproj"
                      AdditionalProperties="EnableServiceCycleProfiler=true;UseGameStubs=true" />
    <ProjectReference Include="../../src/OrbModding.Common/OrbModding.Common.csproj"
                      AdditionalProperties="EnableServiceCycleProfiler=true;UseGameStubs=true" />
    <ProjectReference Include="../../src/OrbAutomata/OrbAutomata.csproj"
                      AdditionalProperties="EnableServiceCycleProfiler=true;UseGameStubs=true" />
    <ProjectReference Include="../../src/OrbModConfig/OrbModConfig.csproj"
                      AdditionalProperties="EnableServiceCycleProfiler=true;UseGameStubs=true" />
  </ItemGroup>
</Project>
