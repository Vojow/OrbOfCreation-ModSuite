<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OrbModding.Tests</AssemblyName>
    <RootNamespace>OrbModding.AutoBuyComparison</RootNamespace>
    <RequireGameReferences>false</RequireGameReferences>
    <ComparisonSourceRoot Condition="'$(ComparisonSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..</ComparisonSourceRoot>
    <DefineConstants Condition="'$(LegacyMainApi)' == 'true'">$(DefineConstants);LEGACY_MAIN_API</DefineConstants>
    <DefineConstants Condition="'$(IntermediateQueueApi)' == 'true'">$(DefineConstants);INTERMEDIATE_QUEUE_API</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\OrbModding.Tests\Simulation\AutoBuySimulation.cs" Link="Simulation\AutoBuySimulation.cs" />
    <Compile Include="..\OrbModding.Tests\Simulation\AutoBuyPerformanceReport.cs" Link="Simulation\AutoBuyPerformanceReport.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(ComparisonSourceRoot)\tests\OrbModding.GameStubs\OrbModding.GameStubs.csproj" />
    <ProjectReference Include="$(ComparisonSourceRoot)\src\OrbModding.Common\OrbModding.Common.csproj" />
    <ProjectReference Include="$(ComparisonSourceRoot)\src\OrbAutomata\OrbAutomata.csproj" />
  </ItemGroup>
</Project>
