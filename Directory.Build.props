<Project>
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <Authors>Vojow</Authors>
    <RepositoryUrl>https://github.com/Vojow/OrbOfCreation-ModSuite</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <SuiteVersion>0.4.0</SuiteVersion>
    <GameRoot>$(OOC_GAME_DIR)</GameRoot>
    <WindowsManagedDir>$(GameRoot)/Orb Of Creation_Data/Managed</WindowsManagedDir>
    <MacAppManagedDir>$(GameRoot)/Contents/Resources/Data/Managed</MacAppManagedDir>
    <MacInstallManagedDir>$(GameRoot)/Orb Of Creation.app/Contents/Resources/Data/Managed</MacInstallManagedDir>
    <ManagedDir Condition="'$(GameRoot)' != '' and Exists('$(WindowsManagedDir)/Assembly-CSharp.dll') and Exists('$(WindowsManagedDir)/Assembly-CSharp-firstpass.dll')">$(WindowsManagedDir)</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)' == '' and '$(GameRoot)' != '' and Exists('$(MacAppManagedDir)/Assembly-CSharp.dll') and Exists('$(MacAppManagedDir)/Assembly-CSharp-firstpass.dll')">$(MacAppManagedDir)</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)' == '' and '$(GameRoot)' != '' and Exists('$(MacInstallManagedDir)/Assembly-CSharp.dll') and Exists('$(MacInstallManagedDir)/Assembly-CSharp-firstpass.dll')">$(MacInstallManagedDir)</ManagedDir>
    <BepInExCoreDir>$(GameRoot)/BepInEx/core</BepInExCoreDir>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;bin-stubs/**;obj/**;obj-stubs/**;bin-profile/**;obj-profile/**;bin-profile-stubs/**;obj-profile-stubs/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseGameStubs)' == 'true'">
    <BaseOutputPath>bin-stubs/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj-stubs/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableServiceCycleProfiler)' == 'true'">
    <DefineConstants>$(DefineConstants);SERVICE_CYCLE_PROFILE</DefineConstants>
    <BaseOutputPath Condition="'$(UseGameStubs)' == 'true'">bin-profile-stubs/</BaseOutputPath>
    <BaseOutputPath Condition="'$(UseGameStubs)' != 'true'">bin-profile/</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(UseGameStubs)' == 'true'">obj-profile-stubs/</BaseIntermediateOutputPath>
    <BaseIntermediateOutputPath Condition="'$(UseGameStubs)' != 'true'">obj-profile/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(RequireGameReferences)' == 'true' and '$(UseGameStubs)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)tests/OrbModding.GameStubs/OrbModding.GameStubs.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(RequireGameReferences)' == 'true' and '$(UseGameStubs)' != 'true' and '$(ManagedDir)' != ''">
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
